    <script>
        function printDefault() {
            window.print();
        }

        function handlePrint() {
            const checkboxes = document.querySelectorAll('.print-toggle');
            const warning = document.getElementById('warning');
            let anyChecked = false;

            const sectionIds = ['sectionA', 'sectionB', 'sectionC', 'sectionD', 'sectionE', 'sectionF'];

            sectionIds.forEach(sectionId => {
                const section = document.getElementById(sectionId);
                if (section) {
                    section.classList.remove('print-hide');
                }
            });

            checkboxes.forEach(checkbox => {
                const targetId = checkbox.dataset.target;
                const targetDiv = document.getElementById(targetId);

                if (targetDiv) {
                    if (checkbox.checked) {
                        anyChecked = true;
                        targetDiv.classList.remove('print-hide');
                    } else {
                        targetDiv.classList.add('print-hide');
                    }
                }
            });

            if (!anyChecked) {
                warning.style.display = 'block';
                return;
            }

            warning.style.display = 'none';

            setTimeout(() => {
                window.print();
            }, 500);

            setTimeout(() => {
                sectionIds.forEach(sectionId => {
                    const section = document.getElementById(sectionId);
                    if (section) {
                        section.classList.remove('print-hide');
                    }
                });
            }, 1000);
        }
    </script>

    <script>
        const svccBaseFrequency = document.getElementById('svcc_base_frequency');
        const occurrenceWrapper = document.getElementById('occurrenceWrapper');
        const svccOccurrence = document.getElementById('svcc_occurrence');
        const svccTypeInput = document.getElementById('svcc_type');

        function syncType() {
            if (svccBaseFrequency.value === 'MONTHLY' && svccOccurrence.value !== '1') {
                svccTypeInput.value = 'MONTHLY-' + svccOccurrence.value + 'X';
            } else {
                svccTypeInput.value = svccBaseFrequency.value;
            }
            return true;
        }

        if (svccBaseFrequency) {
            svccBaseFrequency.addEventListener('change', () => {
                occurrenceWrapper.style.display = svccBaseFrequency.value === 'MONTHLY' ? 'block' : 'none';
                syncType();
            });
            svccOccurrence.addEventListener('change', syncType);
            syncType();
        }
    </script>
