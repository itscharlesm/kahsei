    function formatFrequencyLabel($type)
    {
        if (preg_match('/^MONTHLY-(\d)X$/', $type, $m)) {
            $labels = ['2' => 'Twice', '3' => 'Thrice', '4' => '4 Times'];
            return 'MONTHLY (' . ($labels[$m[1]] ?? $m[1] . 'x') . ' a month)';
        }

        $labels = [
            'BIMONTHLY' => 'EVERY OTHER MONTH',
        ];

        return $labels[$type] ?? $type;
    }
