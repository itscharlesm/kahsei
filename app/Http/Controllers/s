                                            @php
                                                function formatDuration($time)
                                                {
                                                    [$h, $m] = explode(':', $time ?? '00:00:00');
                                                    $h = (int) $h;
                                                    $m = (int) $m;

                                                    if ($h == 0 && $m == 0) return '-';

                                                    if ($h > 0 && $m > 0) {
                                                        return "{$h} hr" . ($h > 1 ? 's' : '') . " {$m} min" . ($m > 1 ? 's' : '');
                                                    }

                                                    if ($h > 0) {
                                                        return "{$h} hr" . ($h > 1 ? 's' : '');
                                                    }

                                                    return "{$m} min" . ($m > 1 ? 's' : '');
                                                }
                                            @endphp

