    <script>
        document.getElementById("searchInput").addEventListener("keyup", function() {
            let value = this.value.toLowerCase();

            // Select all tables with ID containing "Table"
            let tables = document.querySelectorAll('table[id*="Table"]');

            tables.forEach(function(table) {
                let rows = table.querySelectorAll("tbody tr");

                rows.forEach(function(row) {
                    let text = row.innerText.toLowerCase();
                    row.style.display = text.includes(value) ? "" : "none";
                });
            });
        });
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const baseUrl = window.location.origin;
            const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';

            // level => [next level, endpoint suffix, text key, value key]
            const levels = {
                region:       { next: 'province',     url: 'provinces',      text: 'prov_name', val: 'prov_id' },
                province:     { next: 'municipality', url: 'municipalities', text: 'mun_name',  val: 'mun_id' },
                municipality: { next: 'barangay',     url: 'barangays',      text: 'brg_name',  val: 'brg_id' },
                barangay:     null
            };
            const order = ['region', 'province', 'municipality', 'barangay'];

            function reset(group, level) {
                const el = group.querySelector('.loc-' + level);
                el.innerHTML = `<option value="">-- SELECT ${level.toUpperCase()} --</option>`;
                el.disabled = true;
                group.querySelector('.h-' + level).value = '';
            }

            document.addEventListener('change', async function(e) {
                const select = e.target;
                const group = select.closest('.loc-group');
                if (!group) return;

                const level = order.find(l => select.classList.contains('loc-' + l));
                if (!level) return;

                // save selected name into hidden input
                group.querySelector('.h-' + level).value =
                    select.options[select.selectedIndex]?.getAttribute('data-name') || '';

                // reset everything below this level
                order.slice(order.indexOf(level) + 1).forEach(l => reset(group, l));

                const cfg = levels[level];
                if (!cfg || !select.value) return;

                const nextEl = group.querySelector('.loc-' + cfg.next);
                nextEl.innerHTML = '<option value="">Loading...</option>';
                try {
                    const res = await fetch(`${baseUrl}/locations/${select.value}/${cfg.url}`, {
                        headers: {
                            'X-CSRF-TOKEN': csrfToken,
                            'Accept': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });
                    if (!res.ok) throw new Error();
                    const data = await res.json();
                    nextEl.innerHTML = `<option value="">-- SELECT ${cfg.next.toUpperCase()} --</option>`;
                    data.forEach(item => {
                        nextEl.insertAdjacentHTML('beforeend',
                            `<option value="${item[cfg.val]}" data-name="${item[cfg.text]}">${item[cfg.text]}</option>`);
                    });
                    nextEl.disabled = false;
                } catch (err) {
                    nextEl.innerHTML = '<option value="">Error loading</option>';
                }
            });
        });
    </script>

