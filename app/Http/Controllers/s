public function forgot_password(Request $request)
{
    $validator = \Illuminate\Support\Facades\Validator::make($request->all(), [
        'identifier' => 'required|string|max:255',
    ]);

    if ($validator->fails()) {
        alert()->error('Invalid Input', $validator->errors()->first());
        return redirect()->back();
    }

    $identifier = trim($request->identifier);

    // Normalize mobile number in case user enters +63 or leading 0
    $normalizedMobile = preg_replace('/^(\+?63|0)/', '', $identifier);

    $user = DB::table('users')
        ->where('usr_active', 1)
        ->where(function ($query) use ($identifier, $normalizedMobile) {
            $query->where('usr_email', $identifier)
                ->orWhere('usr_mobile', $identifier)
                ->orWhere('usr_mobile', $normalizedMobile);
        })
        ->first();

    if (!$user) {
        alert()->error('Account Not Found', 'No account found with that email or mobile number.');
        return redirect()->back();
    }

    DB::table('users')
        ->where('usr_id', $user->usr_id)
        ->update([
            'usr_password' => md5('123456'),
        ]);

    logUserActivity('Password Reset', 'Password reset requested via forgot password for: ' . $identifier);

    alert()->success('Password Reset Successful', 'Your temporary password is 123456. Please log in and change it immediately.');

    return redirect('/');
}

public function home()
    {
        $vision = DB::table('homepage_vision')->where('vis_active', 1)->first();
        $mission = DB::table('homepage_mission')->where('mis_active', 1)->first();

        $goals = DB::table('homepage_goals')->where('goals_active', 1)->first();
        $objectives = DB::table('homepage_objectives')->where('obj_active', 1)->first();

        // Board members grouped by position (pos_id 1..6) -> one org-chart level each.
        $members = DB::table('users')
            ->join('positions', 'users.usr_position', '=', 'positions.pos_id')
            ->where('users.usr_active', 1)
            ->where('positions.pos_active', 1)
            ->whereIn('positions.pos_id', [1, 2, 3, 4, 5, 6])
            ->select(
                'users.usr_id',
                'users.usr_first_name',
                'users.usr_middle_name',
                'users.usr_last_name',
                'positions.pos_id',
                'positions.pos_name'
            )
            ->orderBy('positions.pos_id', 'asc')
            ->orderBy('users.usr_last_name', 'asc')
            ->orderBy('users.usr_first_name', 'asc')
            ->get();

        $levels = $members->groupBy('pos_id');

        $partners = DB::table('homepage_partners')
            ->where('prt_active', 1)
            ->orderBy('prt_title', 'asc')
            ->get();

        return view('homepage.home', compact(
            'vision',
            'mission',
            'goals',
            'objectives',
            'levels',
            'partners'
        ));
    }

